{
  "name": "@astrov/react-jsoncanvas",
  "version": "0.1.8",
  "description": "React implementation of JSONCanvas renderer with interactive features",
  "homepage": "https://github.com/astrovvv/react-jsoncanvas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrovvv/react-jsoncanvas.git"
  },
  "bugs": {
    "url": "https://github.com/astrovvv/react-jsoncanvas/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "dev:example": "vite --config vite.example.config.ts",
    "build:example": "vite build --config vite.example.config.ts",
    "type-check": "tsc --noEmit",
    "type-check:example": "tsc --noEmit -p tsconfig.example.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "test": "vitest",
    "test:run": "vitest run --threads=false",
    "test:coverage": "vitest run --threads=false --coverage",
    "test:ui": "vitest --ui",
    "prepublishOnly": "npm run type-check && npm run lint && npm run test:run && npm run build"
  },
  "keywords": [
    "react",
    "jsoncanvas",
    "canvas",
    "visualization",
    "interactive",
    "diagram",
    "graph"
  ],
  "author": "Astrov",
  "license": "MIT",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "dependencies": {
    "@trbn/jsoncanvas": "^1.0.6",
    "lucide-react": "^1.48.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "0.34.6",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^22.1.0",
    "prettier": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "vitest": "^0.34.0"
  }
}
